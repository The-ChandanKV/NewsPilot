# Application
NODE_ENV=development
APP_NAME=NewsPilot
LOG_LEVEL=info

# Database (SQLite file path relative to project root)
DATABASE_URL=./data/newspilot.db

# AI provider: "claude" | "gemini"
AI_PROVIDER=gemini

# Similarity for clustering: "deterministic" | "embedding" (embedding falls back until configured)
SIMILARITY_PROVIDER=deterministic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google (Gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# News providers (comma-separated enabled providers)
# Supported: google_news_rss, newsapi, gnews
NEWS_PROVIDERS=google_news_rss,newsapi

# NewsAPI.org
NEWSAPI_API_KEY=

# GNews
GNEWS_API_KEY=

# Optional: load RSS from local fixtures instead of live Google News
# NEWS_RSS_FIXTURE_DIR=./fixtures/rss

# Pipeline defaults (used in later phases)
NEWS_RECENCY_HOURS=48
BRIEFING_CACHE_TTL_SECONDS=10800
# Keep prior topic briefings ~7 days for NEW / UPDATED / ONGOING detection
TOPIC_HISTORY_TTL_SECONDS=604800
# Optional: LLM one-liner for material UPDATED stories (deterministic summaries always run)
EXPLAIN_CHANGES_WITH_AI=false
NEWS_FETCH_CACHE_TTL_SECONDS=1800
MAX_ARTICLES_PER_SEARCH=50
MAX_STORIES_PER_BRIEFING=15
NEWS_PROVIDER_TIMEOUT_MS=10000
NEWS_PROVIDER_MAX_RETRIES=2

# Ranking / clustering (deterministic pipeline)
RANK_WEIGHT_RELEVANCE=0.35
RANK_WEIGHT_FRESHNESS=0.25
RANK_WEIGHT_SOURCE_DIVERSITY=0.2
RANK_WEIGHT_SOURCE_QUALITY=0.2
HEADLINE_NEAR_DUPLICATE_THRESHOLD=0.85
STORY_CLUSTER_SIMILARITY_THRESHOLD=0.5
FRESHNESS_HALF_LIFE_HOURS=24
SOURCE_DIVERSITY_SATURATION=5

# AI summarization (one LLM call per important story cluster)
AI_MAX_OUTPUT_TOKENS=1024
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=2
AI_SUMMARY_CACHE_TTL_SECONDS=21600
MAX_STORIES_TO_SUMMARIZE=8
AI_SUMMARY_MAX_ARTICLES_PER_CLUSTER=6

# Automatic daily briefings (OS cron should call: npm run job:daily-briefings)
DAILY_BRIEFING_HOUR=6
DAILY_BRIEFING_MINUTE=0
DAILY_BRIEFING_TIMEZONE=UTC
DAILY_BRIEFING_FREQUENCIES=daily,twice_daily
# Optional shared secret for POST /api/jobs/daily-briefings
# DAILY_JOB_SECRET=

# Daily news email delivery (reuses stored DailyBriefing — no extra LLM calls)
# NOTIFICATION_PROVIDER: log | resend
NOTIFICATION_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM=NewsPilot <briefs@yourdomain.com>
EMAIL_PROVIDER_TIMEOUT_MS=15000
EMAIL_MAX_SEND_ATTEMPTS=3
APP_BASE_URL=http://localhost:3000
EMAIL_DELIVERY_AFTER_BRIEFINGS=true

# AI news research chat (RAG — retrieves only relevant stored stories)
RESEARCH_MAX_CONTEXT_STORIES=8
RESEARCH_MIN_RELEVANCE=0.15
RESEARCH_BRIEFING_SCAN_LIMIT=60
